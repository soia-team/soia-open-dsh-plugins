# Build output: `lib/` IS committed on purpose, so a `git:` install carries a
# usable entry point without running a build (pnpm blocks dependency build
# scripts). CI rebuilds and fails when the committed output is stale — see
# docs/structure.md. `dist/` stays ignored: nothing distributes it.
dist/
*.tsbuildinfo

# Dependencies
node_modules/
.pnpm-store/

# Test and coverage output
coverage/
.nyc_output/
*.lcov
vitest-report/

# Local scratch and evidence dumps
*.local.yml
scripts/out/
tmp/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Local environment and credentials — never commit these.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
