{
  "name": "soia-dsh-tool-check-skills",
  "version": "0.1.1-snapshot.0",
  "private": false,
  "description": "DSH host tool that audits a session log for whether the expected skills were actually loaded, and classifies the failure when they were not.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0"
    },
    "tokenBudget": {
      "resident": 151,
      "note": "tool block only (resident includes the 2026-09-23 usage-preference sentence); this package adds no prompt section; measured by scripts/token-budget.mjs (4 chars ≈ 1 token)"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2"
  }
}
